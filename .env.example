NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/digital_marketing_hub?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OPENAI_API_KEY=replace-when-chatbot-is-implemented
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
STORAGE_DRIVER=local
UPLOAD_MAX_BYTES=5242880
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_STORAGE_PATH=uploads
LEAD_NOTIFICATION_WEBHOOK_URL=
CHATBOT_VISITOR_LIMIT=20
CHATBOT_VISITOR_WINDOW_SECONDS=600
CHATBOT_SOURCE_LIMIT=100
CHATBOT_SOURCE_WINDOW_SECONDS=3600
POSTGRES_DB=digital_marketing_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
